# 首次部署：仅 HTTP，供 certbot 申请证书
# 执行 certbot --nginx -d mybaicao.com 后会自动添加 HTTPS 配置

server {
    listen 80;
    server_name mybaicao.com www.mybaicao.com;

    location /_next/static/ {
        alias /var/www/baicao-blog-client/.next/static/;
        expires 1y;
        access_log off;
        add_header Cache-Control "public, immutable";
    }

    location /images/ {
        alias /var/www/baicao-blog-client/public/images/;
        expires 7d;
        access_log off;
    }

    location / {
        client_max_body_size 50m;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
